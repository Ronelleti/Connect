DATABASE_URL=postgres://wecomconnect:wecomconnect@localhost:5432/wecomconnect
AUTH_SECRET=replace-this-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=replace-with-at-least-12-characters

# Shared access code everyone must enter once (saved for 30 days) before they can view
# or download anything on the Files page. Leave unset to keep it locked for
# everyone (fails closed, not open) until a code is configured.
FILES_ACCESS_CODE=

# Phone/desktop push notifications (Web Push). Generate a key pair once, on any computer, with
#   npx web-push generate-vapid-keys
# and keep it: changing the keys later makes everyone re-enable notifications. Without them
# the in-app notification bell still works. VAPID_SUBJECT is a contact address for the
# push services (mailto: plus your email); users never see it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Required for the weekly availability reminder (a Netlify scheduled function calls
# /api/cron/availability-reminder with this secret every Sunday). Use a long random value.
CRON_SECRET=
