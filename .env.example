DATABASE_URL=postgres://wecomconnect:wecomconnect@localhost:5432/wecomconnect
AUTH_SECRET=replace-this-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=replace-with-at-least-12-characters

# Optional: sends a swap-approval email with one-click approve/decline links to this
# address whenever an employee submits a shift swap request. Leave MANAGER_APPROVAL_EMAIL
# unset to disable the feature entirely (swaps still work through in-app approval).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
MANAGER_APPROVAL_EMAIL=

# Optional: powers "ask a question about this file" on the shared Files page. Leave
# ANTHROPIC_API_KEY unset to disable it (file upload/download/sharing still work without it).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Shared access code everyone must enter once (saved for 30 days) before they can view,
# ask about, or download anything on the Files page. Leave unset to keep it locked for
# everyone (fails closed, not open) until a code is configured.
FILES_ACCESS_CODE=
